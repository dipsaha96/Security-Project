# Attacker Container
# Tools: Python 3, Scapy, tcpdump
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tcpdump \
    iputils-ping \
    iproute2 \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir scapy

WORKDIR /scripts

# Keep container alive
CMD ["tail", "-f", "/dev/null"]
